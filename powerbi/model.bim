{
  "name": "capacity-to-deadline-optimizer",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "headline",
        "columns": [
          {
            "name": "appointments",
            "dataType": "int64",
            "sourceColumn": "appointments",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_lead",
            "dataType": "double",
            "sourceColumn": "avg_lead",
            "summarizeBy": "sum"
          },
          {
            "name": "within_std_pct",
            "dataType": "double",
            "sourceColumn": "within_std_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "no_show_pct",
            "dataType": "double",
            "sourceColumn": "no_show_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "cancel_pct",
            "dataType": "double",
            "sourceColumn": "cancel_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "refillable",
            "dataType": "int64",
            "sourceColumn": "refillable",
            "summarizeBy": "sum"
          },
          {
            "name": "unused_slots",
            "dataType": "int64",
            "sourceColumn": "unused_slots",
            "summarizeBy": "sum"
          },
          {
            "name": "dq_score",
            "dataType": "double",
            "sourceColumn": "dq_score",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "headline",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\headline.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Appointments",
            "expression": "SELECTEDVALUE ( 'headline'[appointments] )",
            "formatString": "#,0",
            "description": "Appointments from the headline query extract."
          },
          {
            "name": "Avg lead time",
            "expression": "SELECTEDVALUE ( 'headline'[avg_lead] )",
            "formatString": "#,0.0\"d\"",
            "description": "Avg lead time from the headline query extract."
          },
          {
            "name": "Within access standard",
            "expression": "SELECTEDVALUE ( 'headline'[within_std_pct] )",
            "formatString": "0.00\"%\"",
            "description": "Each specialty against its own target"
          },
          {
            "name": "No-show rate",
            "expression": "SELECTEDVALUE ( 'headline'[no_show_pct] )",
            "formatString": "0.00\"%\"",
            "description": "5.27% with a reminder, 15.68% without"
          },
          {
            "name": "Cancellation rate",
            "expression": "SELECTEDVALUE ( 'headline'[cancel_pct] )",
            "formatString": "0.00\"%\"",
            "description": "Cancellation rate from the headline query extract."
          },
          {
            "name": "Slots lost",
            "expression": "SELECTEDVALUE ( 'headline'[unused_slots] )",
            "formatString": "#,0",
            "description": "Cancellations plus no-shows"
          },
          {
            "name": "Refillable cancellations",
            "expression": "SELECTEDVALUE ( 'headline'[refillable] )",
            "formatString": "#,0",
            "description": "Enough notice to offer the slot on"
          }
        ]
      },
      {
        "name": "wl_head",
        "columns": [
          {
            "name": "waiting",
            "dataType": "int64",
            "sourceColumn": "waiting",
            "summarizeBy": "sum"
          },
          {
            "name": "past_requested",
            "dataType": "int64",
            "sourceColumn": "past_requested",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_waiting",
            "dataType": "double",
            "sourceColumn": "avg_waiting",
            "summarizeBy": "sum"
          },
          {
            "name": "high_priority",
            "dataType": "int64",
            "sourceColumn": "high_priority",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "wl_head",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\wl_head.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Waitlist past requested-by",
            "expression": "SELECTEDVALUE ( 'wl_head'[past_requested] )",
            "formatString": "#,0",
            "description": "53.0% of the waitlist"
          }
        ]
      },
      {
        "name": "status",
        "columns": [
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none"
          },
          {
            "name": "appointments",
            "dataType": "int64",
            "sourceColumn": "appointments",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "status",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\status.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Appointments (status)",
            "expression": "SUM ( 'status'[appointments] )",
            "formatString": "#,0.00",
            "description": "Appointments for the 'Appointment outcomes' visual."
          }
        ]
      },
      {
        "name": "by_specialty",
        "columns": [
          {
            "name": "Specialty",
            "dataType": "string",
            "sourceColumn": "Specialty",
            "summarizeBy": "none"
          },
          {
            "name": "target_days",
            "dataType": "int64",
            "sourceColumn": "target_days",
            "summarizeBy": "sum"
          },
          {
            "name": "appointments",
            "dataType": "int64",
            "sourceColumn": "appointments",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_lead",
            "dataType": "double",
            "sourceColumn": "avg_lead",
            "summarizeBy": "sum"
          },
          {
            "name": "within_std_pct",
            "dataType": "double",
            "sourceColumn": "within_std_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "no_show_pct",
            "dataType": "double",
            "sourceColumn": "no_show_pct",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "by_specialty",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\by_specialty.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Avg lead time (days) (by_specialty)",
            "expression": "AVERAGE ( 'by_specialty'[avg_lead] )",
            "formatString": "#,0.00",
            "description": "Avg lead time (days) for the 'Lead time against each specialty's own access standard' visual."
          },
          {
            "name": "Target lead time (days) (by_specialty)",
            "expression": "SUM ( 'by_specialty'[target_days] )",
            "formatString": "#,0.00",
            "description": "Target lead time (days) for the 'Lead time against each specialty's own access standard' visual."
          },
          {
            "name": "Within standard % (by_specialty)",
            "expression": "AVERAGE ( 'by_specialty'[within_std_pct] )",
            "formatString": "#,0.00",
            "description": "Within standard % for the 'Compliance with access standard, by specialty' visual."
          }
        ]
      },
      {
        "name": "reminder",
        "columns": [
          {
            "name": "bucket",
            "dataType": "string",
            "sourceColumn": "bucket",
            "summarizeBy": "none"
          },
          {
            "name": "appointments",
