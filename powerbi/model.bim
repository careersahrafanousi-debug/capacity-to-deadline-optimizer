        "measures": [
          {
            "name": "No-show rate % (reminder)",
            "expression": "AVERAGE ( 'reminder'[no_show_pct] )",
            "formatString": "#,0.00",
            "description": "No-show rate % for the 'The reminder effect' visual."
          }
        ]
      },
      {
