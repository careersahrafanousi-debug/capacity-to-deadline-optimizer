// DAX measures - Capacity to Deadline Optimizer
// Generated by src/build_bi_assets.py from dashboard/dashboard_config.json.
// Paste into Power BI Desktop, or open powerbi/model.bim in Tabular Editor.

// Appointments from the headline query extract.
Appointments =
    SELECTEDVALUE ( 'headline'[appointments] )
// format: #,0

// Avg lead time from the headline query extract.
Avg lead time =
    SELECTEDVALUE ( 'headline'[avg_lead] )
// format: #,0.0"d"

// Each specialty against its own target
Within access standard =
    SELECTEDVALUE ( 'headline'[within_std_pct] )
// format: 0.00"%"

// 5.27% with a reminder, 15.68% without
No-show rate =
    SELECTEDVALUE ( 'headline'[no_show_pct] )
// format: 0.00"%"

// Cancellation rate from the headline query extract.
Cancellation rate =
    SELECTEDVALUE ( 'headline'[cancel_pct] )
// format: 0.00"%"

// Cancellations plus no-shows
Slots lost =
    SELECTEDVALUE ( 'headline'[unused_slots] )
// format: #,0

// Enough notice to offer the slot on
Refillable cancellations =
    SELECTEDVALUE ( 'headline'[refillable] )
// format: #,0

// 53.0% of the waitlist
Waitlist past requested-by =
    SELECTEDVALUE ( 'wl_head'[past_requested] )
// format: #,0

// Avg lead time (days) for the 'Lead time against each specialty's own access standard' visual.
Avg lead time (days) (by_specialty) =
    AVERAGE ( 'by_specialty'[avg_lead] )
// format: #,0.00

// Target lead time (days) for the 'Lead time against each specialty's own access standard' visual.
Target lead time (days) (by_specialty) =
    SUM ( 'by_specialty'[target_days] )
// format: #,0.00

// Appointments for the 'Appointment outcomes' visual.
Appointments (status) =
    SUM ( 'status'[appointments] )
// format: #,0.00

// Within standard % for the 'Compliance with access standard, by specialty' visual.
Within standard % (by_specialty) =
    AVERAGE ( 'by_specialty'[within_std_pct] )
// format: #,0.00

// No-show rate % for the 'The reminder effect' visual.
No-show rate % (reminder) =
    AVERAGE ( 'reminder'[no_show_pct] )
// format: #,0.00

// No-show rate % for the 'Longer waits, worse attendance' visual.
No-show rate % (lead_bands) =
    AVERAGE ( 'lead_bands'[no_show_pct] )
// format: #,0.00

// Cancellation rate % for the 'Longer waits, worse attendance' visual.
Cancellation rate % (lead_bands) =
    AVERAGE ( 'lead_bands'[cancel_pct] )
// format: #,0.00

// Slots recovered for the 'What refilling cancelled slots would actually buy' visual.
Slots recovered (fill_sim) =
    SUM ( 'fill_sim'[slots] )
// format: #,0.00

// % of completed volume for the 'What refilling cancelled slots would actually buy' visual.
% of completed volume (fill_sim) =
    AVERAGE ( 'fill_sim'[pct_of_completed] )
// format: #,0.00

// No-show rate % for the 'No-shows by time of day' visual.
No-show rate % (by_hour) =
    AVERAGE ( 'by_hour'[no_show_pct] )
// format: #,0.00

// No-show rate % for the 'Time block performance' visual.
No-show rate % (time_block) =
    AVERAGE ( 'time_block'[no_show_pct] )
// format: #,0.00

// Cancellation rate % for the 'Time block performance' visual.
Cancellation rate % (time_block) =
    AVERAGE ( 'time_block'[cancel_pct] )
// format: #,0.00

// Entries for the 'Waitlist by match priority' visual.
Entries (wl_priority) =
    SUM ( 'wl_priority'[entries] )
// format: #,0.00

// Avg days waiting for the 'Waitlist by match priority' visual.
Avg days waiting (wl_priority) =
    AVERAGE ( 'wl_priority'[avg_waiting] )
// format: #,0.00

// Offer acceptance % for the 'Notification opt-in — a null finding, reported anyway' visual.
Offer acceptance % (optin) =
    AVERAGE ( 'optin'[acceptance_pct] )
// format: #,0.00

// Appointments for the 'Monthly trend' visual.
Appointments (monthly) =
    SUM ( 'monthly'[appointments] )
// format: #,0.00

// Within standard % for the 'Monthly trend' visual.
Within standard % (monthly) =
    AVERAGE ( 'monthly'[within_std_pct] )
// format: #,0.00

// Avg lead time (days) for the 'Monthly trend' visual.
Avg lead time (days) (monthly) =
    AVERAGE ( 'monthly'[avg_lead] )
// format: #,0.00
